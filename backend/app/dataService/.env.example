# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Adobe Credentials
ADOBE_CLIENT_ID=your_adobe_client_id_here
ADOBE_CLIENT_SECRET=your_adobe_client_secret_here

# Directory Configuration (optional - will use defaults if not set)
DATA_DIR=./app/dataService/data
META_DIR=./app/dataService/data/meta
TEMP_DIR=./app/dataService/data/temp
TABLE_DIR=./app/dataService/data/table
FIGURE_DIR=./app/dataService/data/figure
VECTORSTORE_DIR=./app/dataService/data/vectorstore

# Model Configuration (optional - will use defaults if not set)
TABLE_MODEL=gpt-4o
FIGURE_MODEL=gpt-4o-mini
META_MODEL=gpt-3.5-turbo-1106

# Backend Configuration
BACKEND_PORT=5010
